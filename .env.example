# MedVault Configuration
# Copy this to .env and edit with your values

# REQUIRED: Generate a strong random secret for JWT signing
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# JWT token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=48h

# Database path (inside container, mapped to volume)
DB_PATH=./data/medvault.db

# Server port
PORT=8080

# Who can create accounts: open | invite | closed
# invite: a household invite code is required. closed: admin CLI only.
REGISTRATION_MODE=open

# Bcrypt cost factor (10-14, higher = slower but more secure)
BCRYPT_COST=12
