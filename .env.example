# MedVault Configuration
# Copy this to .env and edit with your values

# REQUIRED: Generate a strong random secret for JWT signing
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# JWT token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=48h

# Database path for `go run` (docker compose sets /app/data/medvault.db)
DB_PATH=./data/medvault.db

# Server port (also the host port published by docker compose)
PORT=8080

# Host interface docker compose publishes on. Use 127.0.0.1 when a reverse
# proxy on the same host terminates TLS, so the plain-HTTP port is not
# reachable from the network.
BIND_ADDR=0.0.0.0

# HTTPS through Caddy (see docs/HTTPS.md). Uncomment to enable.
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# DOMAIN=meds.example.com
# CADDY_TLS: "internal" for LAN use, or an email address for Let's Encrypt
# CADDY_TLS=internal
# HTTP_PORT=80
# HTTPS_PORT=443
# Compose network subnet and Caddy's address in it; change only on a clash
# CADDY_SUBNET=172.30.250.0/24
# CADDY_IP=172.30.250.10

# Who can create accounts: open | invite | closed
# invite: a household invite code is required. closed: admin CLI only.
REGISTRATION_MODE=open

# Daily server-side backups. Empty disables them. In Docker, a path under
# /app/data keeps them in the data volume (see README "Backup and restore").
# BACKUP_DIR=/app/data/backups
# BACKUP_RETAIN_DAYS=14
# BACKUP_HOUR=3
# Time zone for BACKUP_HOUR and logs; the container defaults to UTC
# TZ=Europe/Kyiv

# AI assistant (optional). Default model until a server admin sets one in
# Settings. Empty AI_MODEL disables the default.
# AI_PROVIDER: openai (any OpenAI-compatible endpoint) | anthropic
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=qwen2.5vl:7b
# AI_VISION_MODEL=
# AI_TIMEOUT=60s
# Encrypts the API key saved in Settings; defaults to JWT_SECRET
# AI_SECRET=
